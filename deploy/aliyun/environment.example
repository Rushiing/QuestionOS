# Copy to a private file outside the checkout; chmod 600. Never commit real values.
# Fill from the currently deployed service, not a developer .env file.
QOS_POSTGRES_IMAGE=postgres:18-alpine
QOS_BACKEND_IMAGE=
QOS_FRONTEND_IMAGE=
QOS_MONITOR_IMAGE=questionos-monitor:ecadf090a2d683fb872ac463acc819de06d06530
# Record immutable image IDs/digests before release; tags alone are not evidence.
QOS_POSTGRES_PASSWORD=
QUESTIONOS_AUTH_JWT_SECRET=
QUESTIONOS_SANDBOX_TOKEN=
QUESTIONOS_GOOGLE_CLIENT_ID=
QUESTIONOS_LLM_ENDPOINT=
QUESTIONOS_LLM_API_KEY=
QUESTIONOS_LLM_MODEL=
QUESTIONOS_LLM_EXTRA_BODY_ENABLE_THINKING=false
QOS_PUBLIC_ORIGIN=https://questionos.daydreamer.world
# Internal target during rehearsal; use the approved public origin after cutover.
QOS_MONITOR_FRONTEND_URL=http://frontend:3000

# Required for old-account email verification before public cutover (SMTP STARTTLS).
QUESTIONOS_SMTP_HOST=smtpdm.aliyun.com
QUESTIONOS_SMTP_PORT=80
QUESTIONOS_SMTP_USERNAME=accounts@mail.daydreamer.world
QUESTIONOS_SMTP_PASSWORD=
QUESTIONOS_CLAIM_MAIL_FROM='QuestionOS <accounts@mail.daydreamer.world>'
